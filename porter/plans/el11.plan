# el11 (2026-10-25): the clean cut set plus periodic passes (every n presents) for the cuts that break the picture.
measure 60
safe 60 switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_QUIET_PUBLISH on;;passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;pass q0|Frame/Deferred/Grass;;passx q0|Frame/Interior Volumes;;passx q0|Frame/Deferred wetness;;passx q0|Frame/Deferred/Tiled Decals;;passx q0|Frame/SSDO;;passx q0|Frame/Separable Scattering;;passx q0|Frame/Vcull;;pass q0|Frame/Vcull/;;passx q51|CS Cloth;;pass q0|Frame/Terrain Deformer Depth;;passx q0|Frame/Composite depth bias
safe-brk-every2 60 switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_QUIET_PUBLISH on;;passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;pass q0|Frame/Deferred/Grass;;passx q0|Frame/Interior Volumes;;passx q0|Frame/Deferred wetness;;passx q0|Frame/Deferred/Tiled Decals;;passx q0|Frame/SSDO;;passx q0|Frame/Separable Scattering;;passx q0|Frame/Vcull;;pass q0|Frame/Vcull/;;passx q51|CS Cloth;;pass q0|Frame/Terrain Deformer Depth;;passx q0|Frame/Composite depth bias;;every 2;;pass Water;;passx q0|Frame/Proxy Set Fill Streams;;passx q0|Frame/Lighting/CS Lights
safe-brk-every3 60 switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_QUIET_PUBLISH on;;passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;pass q0|Frame/Deferred/Grass;;passx q0|Frame/Interior Volumes;;passx q0|Frame/Deferred wetness;;passx q0|Frame/Deferred/Tiled Decals;;passx q0|Frame/SSDO;;passx q0|Frame/Separable Scattering;;passx q0|Frame/Vcull;;pass q0|Frame/Vcull/;;passx q51|CS Cloth;;pass q0|Frame/Terrain Deformer Depth;;passx q0|Frame/Composite depth bias;;every 3;;pass Water;;passx q0|Frame/Proxy Set Fill Streams;;passx q0|Frame/Lighting/CS Lights
base-1 60
all-every2 60 switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_QUIET_PUBLISH on;;every 2;;passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;pass q0|Frame/Deferred/Grass;;passx q0|Frame/Interior Volumes;;passx q0|Frame/Deferred wetness;;passx q0|Frame/Deferred/Tiled Decals;;passx q0|Frame/SSDO;;passx q0|Frame/Separable Scattering;;passx q0|Frame/Vcull;;pass q0|Frame/Vcull/;;passx q51|CS Cloth;;pass q0|Frame/Terrain Deformer Depth;;passx q0|Frame/Composite depth bias;;pass Water;;passx q0|Frame/Proxy Set Fill Streams;;passx q0|Frame/Lighting/CS Lights
all-every3 60 switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_QUIET_PUBLISH on;;every 3;;passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;pass q0|Frame/Deferred/Grass;;passx q0|Frame/Interior Volumes;;passx q0|Frame/Deferred wetness;;passx q0|Frame/Deferred/Tiled Decals;;passx q0|Frame/SSDO;;passx q0|Frame/Separable Scattering;;passx q0|Frame/Vcull;;pass q0|Frame/Vcull/;;passx q51|CS Cloth;;pass q0|Frame/Terrain Deformer Depth;;passx q0|Frame/Composite depth bias;;pass Water;;passx q0|Frame/Proxy Set Fill Streams;;passx q0|Frame/Lighting/CS Lights
all-every4 60 switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_QUIET_PUBLISH on;;every 4;;passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;pass q0|Frame/Deferred/Grass;;passx q0|Frame/Interior Volumes;;passx q0|Frame/Deferred wetness;;passx q0|Frame/Deferred/Tiled Decals;;passx q0|Frame/SSDO;;passx q0|Frame/Separable Scattering;;passx q0|Frame/Vcull;;pass q0|Frame/Vcull/;;passx q51|CS Cloth;;pass q0|Frame/Terrain Deformer Depth;;passx q0|Frame/Composite depth bias;;pass Water;;passx q0|Frame/Proxy Set Fill Streams;;passx q0|Frame/Lighting/CS Lights
base-2 60
safe-2 60 switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_QUIET_PUBLISH on;;passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;pass q0|Frame/Deferred/Grass;;passx q0|Frame/Interior Volumes;;passx q0|Frame/Deferred wetness;;passx q0|Frame/Deferred/Tiled Decals;;passx q0|Frame/SSDO;;passx q0|Frame/Separable Scattering;;passx q0|Frame/Vcull;;pass q0|Frame/Vcull/;;passx q51|CS Cloth;;pass q0|Frame/Terrain Deformer Depth;;passx q0|Frame/Composite depth bias
safe-brk-every4 60 switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_QUIET_PUBLISH on;;passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;pass q0|Frame/Deferred/Grass;;passx q0|Frame/Interior Volumes;;passx q0|Frame/Deferred wetness;;passx q0|Frame/Deferred/Tiled Decals;;passx q0|Frame/SSDO;;passx q0|Frame/Separable Scattering;;passx q0|Frame/Vcull;;pass q0|Frame/Vcull/;;passx q51|CS Cloth;;pass q0|Frame/Terrain Deformer Depth;;passx q0|Frame/Composite depth bias;;every 4;;pass Water;;passx q0|Frame/Proxy Set Fill Streams;;passx q0|Frame/Lighting/CS Lights
base-3 60
