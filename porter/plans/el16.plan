# el16 (2026-10-25): on top of deferred stores + HTILE item masks (dh): dispatch miss items (m) and draw-ahead #6188 (da), 3 rounds; then the clean cut set r0 with the same switches, 2 rounds.
measure 60
base-1 75
dh-1 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on
dhm-1 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on
dhda-1 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_NO_DRAW_AHEAD off
dhmda-1 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_NO_DRAW_AHEAD off
base-2 75
dh-2 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on
dhm-2 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on
dhda-2 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_NO_DRAW_AHEAD off
dhmda-2 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_NO_DRAW_AHEAD off
base-3 75
dh-3 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on
dhm-3 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on
dhda-3 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_NO_DRAW_AHEAD off
dhmda-3 75 deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_NO_DRAW_AHEAD off
base-y 75
r0-1 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps
r0-dh-1 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;deferstores on;;switch APS5_ITEM_HTILE_MASKS on
r0-dhm-1 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on
r0-dhda-1 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_NO_DRAW_AHEAD off
r0-dhmda-1 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_NO_DRAW_AHEAD off
r0-2 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps
r0-dh-2 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;deferstores on;;switch APS5_ITEM_HTILE_MASKS on
r0-dhm-2 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on
r0-dhda-2 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_NO_DRAW_AHEAD off
r0-dhmda-2 75 passx q0|Frame/Cascaded shadow map;;pass q0|Frame/Cascaded shadow map/;;passx q30|Directional Shadow Combine;;passx q30|Enqueue Shadow Resolve;;pass q30|Resolve Shadow Map Slice;;passx q38|Directional Shadow Copy;;pass q30|Screen Space Shadows;;pass Particle;;passx q38|Ambient Spec Update;;passx q38|Async ambient sh;;passx q38|Cull CS Lights;;passx q38|Volfog;;passx q38|SSR;;passx q48|Async Sh Grid Update;;passx q48|Async Clouds Update;;passx q30|Update Oct Maps;;deferstores on;;switch APS5_ITEM_HTILE_MASKS on;;switch APS5_PIPELINE_DISPATCH_MISSES on;;switch APS5_NO_DRAW_AHEAD off
base-z 75
